function shuffled<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function TapeCell({ char, active, done }: { char: string; active: boolean; done: boolean }) {
  return (
    <motion.div
      layout
      className={`w-12 h-14 flex items-center justify-center border-2 rounded-md font-mono text-xl font-bold transition-all ${
        active
          ? "border-chart-4 bg-chart-4/20 text-chart-4 shadow-[0_0_12px_rgba(0,255,0,0.4)] scale-110"
          : done
            ? "border-chart-4/40 bg-chart-4/5 text-chart-4/60"
            : "border-border bg-black/40 text-foreground"
      }`}
    >
      {char === "_" ? <span className="opacity-20">_</span> : char}
    </motion.div>
  );
}

type MachineTypeBadgeProps = { type: "DFA" | "NFA" | "TM" };
function MachineTypeBadge({ type }: MachineTypeBadgeProps) {
  const colors: Record<string, string> = {
