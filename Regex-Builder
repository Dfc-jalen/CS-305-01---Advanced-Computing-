import { useState, useEffect, useRef } from "react";
import { Link } from "wouter";
import { motion, AnimatePresence } from "framer-motion";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Code2, ArrowLeft, Check, X, Trophy, ChevronRight, Lightbulb } from "lucide-react";

type MachineViz = {
  type: "DFA" | "NFA" | "TM";
  states: { name: string; isStart: boolean; isAccept: boolean }[];
  transitions: { from: string; on: string; to: string | string[] }[];
  description: string;
};

type Puzzle = {
  id: string;
  regex: RegExp;
  regexDisplay: string;
  title: string;
  challenge: string;
  hint: string;
  machine: MachineViz;
  sampleRejects: string[];
};

