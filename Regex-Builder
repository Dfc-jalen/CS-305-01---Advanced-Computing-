  {
    id: "p1",
    regex: /^a+$/,
    regexDisplay: "a+",
    title: "Pure A's",
    challenge: "Type a string of one or more 'a's — no other symbols allowed.",
    hint: "Try: a, aa, aaa",
    sampleRejects: ["b", "ab", "ba", ""],
    machine: {
      type: "DFA",
      description: "DFA accepting one or more 'a's over {a,b}.",
